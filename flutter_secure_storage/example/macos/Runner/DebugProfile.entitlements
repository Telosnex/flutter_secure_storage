<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  No keychain-access-groups here. It is a restricted entitlement: a
	  build signed without a provisioning profile (CI signs ad hoc) is
	  killed by AMFI at launch, so the integration test never connects.
	  The plugin's default macOS storage (the legacy file keychain, with no
	  access group) needs no entitlement, so the default path is still tested.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
